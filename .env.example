# --- Database (Neon / any Postgres) ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# --- ML service (server-only; never NEXT_PUBLIC_) ---
ML_SERVICE_URL=http://localhost:7860
ML_API_KEY=            # openssl rand -hex 32, same value as the ML service

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# --- Payments (Dodo) ---
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_PRODUCT_ID_2DAYS=
DODO_PAYMENTS_PRODUCT_ID_7DAYS=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
IP_HASH_SALT=          # any random string

# --- Analytics (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Feature flags ---
NEXT_PUBLIC_PAYMENTS_ENABLED=false     # true = show pricing + Dodo checkout (needs Dodo live approval)
NEXT_PUBLIC_DAILY_ANALYSIS_LIMIT=10    # per signed-in user per rolling 24h while payments are off
